# Copy this file to .env and replace every placeholder before starting the API.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-a-database-password
DB_NAME=aquaplants
# TLS toward PostgreSQL. Use "require" (or "verify-full") for AWS RDS and
# "disable" for a local PostgreSQL/Docker without TLS.
DB_SSLMODE=require
# Optional CA bundle path for verify-ca/verify-full (AWS RDS global bundle).
DB_SSLROOTCERT=

# Set to 1 in production once the schema is managed manually. This prevents
# the API from creating tables/indexes or altering columns at startup.
SKIP_INIT_DB=0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated browser origins; do not use "*" with credentials.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Minutes a JWT stays valid (5-1440). Optional, defaults to 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application log level (DEBUG, INFO, WARNING, ERROR). Optional.
LOG_LEVEL=INFO

# Concurrency tuning for many simultaneous users. Optional.
# On PaaS (Render, App Runner) the platform sets PORT; API_HOST must be
# 0.0.0.0 so the container accepts external traffic.
API_HOST=127.0.0.1
API_PORT=8000
# Total DB connections = API_WORKERS * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
API_WORKERS=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
API_THREADS=60

# Seconds to wait when checking a device's TCP reachability (0.2-10).
DEVICE_CONNECT_TIMEOUT=2.0

# Password recovery. Codes are sent to the user's backup email or phone.
PASSWORD_RESET_CODE_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=15
# Minutes a magic link remains valid.
PASSWORD_RESET_LINK_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
# Frontend base URL used to build the recovery link (no trailing slash).
FRONTEND_URL=http://127.0.0.1:5500
# Development only: return the code in the API response when SMTP/Twilio are
# not configured. Keep it at 0 in production.
PASSWORD_RESET_DEV_MODE=0

# Login brute-force protection. Failed attempts are limited per identifier and
# per IP inside a rolling window. Returns HTTP 429 with Retry-After.
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=100
LOGIN_WINDOW_SECONDS=300

# Outgoing email (SMTP). If empty, the recovery code is written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# SMS via Twilio. If empty, email or the API log is used instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Only needed when initializing a completely empty database.
AQUAPLANTS_ADMIN_USERNAME=
AQUAPLANTS_ADMIN_EMAIL=
AQUAPLANTS_ADMIN_PASSWORD=
